# Copy to `.env` and fill in. `.env` is git-ignored on purpose.
# `python scripts/start_mcp.py --setup` does the copy and the questions for you.
#
# EspoCRM instance base URL. A subdirectory install keeps its path:
#   https://crm.example.com
#   https://crm.example.com/espocrm
ESPO_URL=https://crm.example.com

# API key of the API user (Admin -> Users -> [user] -> API Key -> Generate).
# Do not use an administrator account: nothing here needs one.
ESPO_API_KEY=

# Optional ------------------------------------------------------------------

# Comma-separated allow-list. When set, every tool rejects entities outside it
# before sending a request.
# MCP_ENTITY_ALLOW=Account,Contact,Opportunity

# frontend (default) caches GET /Metadata and navigates it locally, which works
# for a non-admin API user. admin uses the filtered ?key= endpoint instead.
# ESPO_METADATA_MODE=frontend

# Assign new Meeting/Call/Task records to the API user when no assignee is given.
# Set to 0 if the role forbids the field.
# ESPO_AUTO_ASSIGN=1

# Working offset used to convert datetimes to UTC. America/Guayaquil is UTC-5
# all year round, which is why -5 is the default.
# ESPO_UTC_OFFSET=-5

# Per-request timeout in seconds, retries, backoff base and log level.
# ESPO_TIMEOUT=30
# ESPO_MAX_RETRIES=2
# ESPO_RETRY_BACKOFF=0.5
# ESPO_LOG_LEVEL=INFO

# Port used with `python server.py --http`.
# MCP_PORT=8000
